---
const title = "Local LLM Visual Benchmark";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #eef1f3;
        --surface: #f9fafb;
        --panel: #ffffff;
        --panel-strong: #f3f6f7;
        --ink: #11161a;
        --muted: #5d6670;
        --subtle: #7b848d;
        --border: #d6dde2;
        --border-strong: #aeb8c0;
        --accent: #0f766e;
        --accent-strong: #0b5d57;
        --warn: #a35f00;
        --danger: #b42318;
        --ok: #247a3d;
        --shadow: 0 1px 2px rgba(18, 28, 35, 0.06);
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-width: 0;
        background: var(--bg);
      }

      body {
        margin: 0;
        min-width: 0;
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(238, 241, 243, 0) 220px),
          var(--bg);
        color: var(--ink);
        font-family: Aptos, "Segoe UI", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        letter-spacing: 0;
      }

      button,
      input {
        font: inherit;
        letter-spacing: 0;
      }

      button {
        min-height: 32px;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        background: var(--panel);
        color: var(--ink);
        cursor: pointer;
        font-size: 13px;
        font-weight: 650;
        line-height: 1;
        padding: 0 11px;
      }

      button:hover:not(:disabled) {
        border-color: #7d8b94;
        background: #f7f9fa;
      }

      button:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }

      input[type="text"],
      input[type="number"] {
        width: 100%;
        min-width: 0;
        min-height: 34px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #ffffff;
        color: var(--ink);
        padding: 0 10px;
      }

      input:focus-visible,
      button:focus-visible {
        outline: 2px solid rgba(15, 118, 110, 0.26);
        outline-offset: 2px;
      }

      .app {
        width: min(1480px, calc(100vw - 28px));
        margin: 0 auto;
        padding: 18px 0 28px;
      }

      .topbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 16px;
        margin-bottom: 14px;
      }

      h1 {
        margin: 0;
        font-size: clamp(22px, 2.4vw, 30px);
        line-height: 1.05;
        font-weight: 760;
      }

      .subline {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        color: var(--muted);
        font-size: 13px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
      }

      .status-pill,
      .chip,
      .metric {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 28px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--panel);
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
        padding: 0 10px;
        white-space: nowrap;
      }

      .status-pill::before {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--subtle);
        content: "";
      }

      .status-pill[data-state="online"]::before {
        background: var(--ok);
      }

      .status-pill[data-state="offline"]::before,
      .status-pill[data-state="error"]::before {
        background: var(--danger);
      }

      .grid {
        display: grid;
        grid-template-columns: minmax(300px, 380px) minmax(0, 1fr) minmax(280px, 340px);
        gap: 12px;
        align-items: start;
      }

      .stack {
        display: grid;
        gap: 12px;
        min-width: 0;
      }

      .panel {
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: var(--shadow);
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 43px;
        border-bottom: 1px solid var(--border);
        padding: 9px 12px;
      }

      .panel-title {
        margin: 0;
        font-size: 13px;
        font-weight: 780;
        text-transform: uppercase;
      }

      .panel-body {
        padding: 12px;
      }

      .form-grid {
        display: grid;
        gap: 10px;
      }

      .field {
        display: grid;
        gap: 5px;
      }

      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 720;
      }

      .inline-field {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
      }

      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .check-list {
        display: grid;
        gap: 7px;
        max-height: 210px;
        overflow: auto;
        padding-right: 2px;
      }

      .check-row {
        display: grid;
        grid-template-columns: 17px minmax(0, 1fr);
        gap: 8px;
        align-items: start;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        padding: 8px;
      }

      .check-row input {
        margin: 1px 0 0;
      }

      .check-title {
        display: block;
        overflow-wrap: anywhere;
        font-size: 13px;
        font-weight: 720;
        line-height: 1.25;
      }

      .check-desc {
        display: block;
        margin-top: 2px;
        color: var(--subtle);
        font-size: 12px;
        line-height: 1.3;
      }

      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
      }

      .primary {
        border-color: var(--accent-strong);
        background: var(--accent);
        color: #ffffff;
      }

      .primary:hover:not(:disabled) {
        border-color: #084c47;
        background: var(--accent-strong);
      }

      .danger {
        border-color: rgba(180, 35, 24, 0.55);
        color: var(--danger);
      }

      .segmented {
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--panel-strong);
        padding: 2px;
      }

      .segmented button {
        min-height: 28px;
        border: 0;
        background: transparent;
        padding: 0 10px;
      }

      .segmented button[aria-pressed="true"] {
        background: var(--panel);
        box-shadow: var(--shadow);
        color: var(--accent-strong);
      }

      .queue-grid,
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .metric {
        justify-content: space-between;
        min-height: 46px;
        border-radius: 7px;
        white-space: normal;
      }

      .metric strong {
        color: var(--ink);
        font-size: 14px;
      }

      .metric span {
        color: var(--subtle);
        font-size: 11px;
        text-transform: uppercase;
      }

      .current-job {
        display: grid;
        gap: 6px;
        min-height: 74px;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--panel-strong);
        padding: 10px;
      }

      .current-job strong {
        overflow-wrap: anywhere;
        font-size: 14px;
      }

      .small {
        color: var(--subtle);
        font-size: 12px;
        line-height: 1.4;
      }

      .message {
        min-height: 20px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.35;
      }

      .message[data-tone="error"] {
        color: var(--danger);
      }

      .message[data-tone="warn"] {
        color: var(--warn);
      }

      .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 10px;
      }

      .run-card {
        display: grid;
        gap: 8px;
        width: 100%;
        min-width: 0;
        min-height: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--panel);
        padding: 8px;
        text-align: left;
      }

      .run-card:hover {
        border-color: var(--border-strong);
      }

      .preview {
        position: relative;
        display: grid;
        place-items: center;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 6px;
        background:
          linear-gradient(135deg, #eef3f2 25%, transparent 25%) -8px 0 / 16px 16px,
          linear-gradient(225deg, #eef3f2 25%, transparent 25%) -8px 0 / 16px 16px,
          linear-gradient(315deg, #eef3f2 25%, transparent 25%) 0 0 / 16px 16px,
          linear-gradient(45deg, #eef3f2 25%, #f7f9fa 25%) 0 0 / 16px 16px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 720;
      }

      .preview img,
      .preview video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .fallback-note {
        position: absolute;
        right: 6px;
        bottom: 6px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.92);
        color: var(--warn);
        font-size: 11px;
        font-weight: 760;
        padding: 4px 7px;
      }

      .run-meta {
        display: grid;
        gap: 3px;
      }

      .run-meta strong {
        overflow-wrap: anywhere;
        font-size: 13px;
        line-height: 1.25;
      }

      .empty {
        display: grid;
        place-items: center;
        min-height: 220px;
        border: 1px dashed var(--border-strong);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.48);
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        padding: 18px;
      }

      .detail-backdrop {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(16, 23, 28, 0.48);
        padding: 16px;
      }

      .detail-backdrop[open] {
        display: flex;
      }

      .detail-dialog {
        width: min(940px, 100%);
        max-height: min(760px, calc(100vh - 32px));
        overflow: auto;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 18px 44px rgba(15, 25, 33, 0.24);
      }

      .detail-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(250px, 320px);
        gap: 12px;
        padding: 12px;
      }

      .kv {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr);
        gap: 5px 10px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.35;
      }

      .kv strong {
        color: var(--ink);
      }

      pre {
        max-height: 240px;
        overflow: auto;
        margin: 0;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: #f6f8f9;
        color: #172026;
        font-size: 12px;
        line-height: 1.45;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        padding: 10px;
      }

      a {
        color: var(--accent-strong);
        font-weight: 720;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .link-row {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }

      @media (max-width: 1120px) {
        .grid {
          grid-template-columns: minmax(290px, 360px) minmax(0, 1fr);
        }

        .right-rail {
          grid-column: 1 / -1;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .app {
          width: min(100%, calc(100vw - 20px));
          padding-top: 12px;
        }

        .topbar,
        .grid,
        .right-rail,
        .detail-body {
          grid-template-columns: 1fr;
        }

        .toolbar {
          justify-content: flex-start;
        }

        .split,
        .actions,
        .queue-grid,
        .stats-grid {
          grid-template-columns: 1fr;
        }

        .panel-header {
          align-items: flex-start;
          flex-direction: column;
        }

        .inline-field {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="app" data-control-center>
      <header class="topbar">
        <div>
          <h1>{title}</h1>
          <div class="subline">
            <span>Local control center</span>
            <span id="benchmarkCount">Loading benchmarks</span>
            <span id="modelCount">Models pending</span>
          </div>
        </div>
        <div class="toolbar" aria-label="Global controls">
          <span class="status-pill" data-state="checking" id="connectionPill">Checking</span>
          <div class="segmented" aria-label="Result media">
            <button type="button" data-media="image" aria-pressed="true">Image</button>
            <button type="button" data-media="video" aria-pressed="false">Video</button>
          </div>
        </div>
      </header>

      <div class="grid">
        <div class="stack">
          <section class="panel" aria-labelledby="connectionTitle">
            <div class="panel-header">
              <h2 class="panel-title" id="connectionTitle">Connection</h2>
              <span class="chip" id="connectionLabel">Not tested</span>
            </div>
            <div class="panel-body form-grid">
              <div class="field">
                <div class="label-row">
                  <label for="baseUrl">LM Studio base URL</label>
                </div>
                <div class="inline-field">
                  <input id="baseUrl" name="baseUrl" type="text" value="http://localhost:1234/v1" autocomplete="off" />
                  <button type="button" id="testConnection">Test</button>
                </div>
              </div>
              <div class="message" id="connectionMessage">Waiting for local API.</div>
              <div class="field">
                <div class="label-row">
                  <span>Discovered models</span>
                  <span id="modelListCount">0</span>
                </div>
                <div class="check-list" id="modelList" aria-live="polite">
                  <div class="empty">No models discovered</div>
                </div>
              </div>
            </div>
          </section>

          <section class="panel" aria-labelledby="setupTitle">
            <div class="panel-header">
              <h2 class="panel-title" id="setupTitle">Run Setup</h2>
              <span class="chip" id="matrixSize">0 jobs</span>
            </div>
            <div class="panel-body form-grid">
              <div class="field">
                <div class="label-row">
                  <span>Benchmarks</span>
                  <span id="benchmarkListCount">0</span>
                </div>
                <div class="check-list" id="benchmarkList" aria-live="polite">
                  <div class="empty">Loading benchmarks</div>
                </div>
              </div>
              <div class="split">
                <div class="field">
                  <div class="label-row">
                    <label for="repeatCount">Repeats</label>
                  </div>
                  <input id="repeatCount" type="number" min="1" max="50" step="1" value="1" />
                </div>
                <div class="field">
                  <div class="label-row">
                    <label for="captureAtMs">PNG timestamp</label>
                    <span>ms</span>
                  </div>
                  <input id="captureAtMs" type="number" min="0" step="250" value="5000" />
                </div>
              </div>
              <label class="check-row" for="videoGeneration">
                <input id="videoGeneration" type="checkbox" />
                <span>
                  <span class="check-title">Video generation</span>
                  <span class="check-desc">Off by default; PNG remains the fallback.</span>
                </span>
              </label>
              <div class="actions">
                <button class="primary" type="button" id="startQueue">Start</button>
                <button type="button" id="stopQueue">Stop after current</button>
                <button class="danger" type="button" id="cancelQueue">Cancel now</button>
              </div>
              <div class="message" id="queueMessage"></div>
            </div>
          </section>
        </div>

        <section class="panel" aria-labelledby="resultsTitle">
          <div class="panel-header">
            <h2 class="panel-title" id="resultsTitle">Results</h2>
            <span class="chip" id="runCount">0 runs</span>
          </div>
          <div class="panel-body">
            <div class="results-grid" id="resultsGrid" aria-live="polite">
              <div class="empty">No runs yet</div>
            </div>
          </div>
        </section>

        <div class="stack right-rail">
          <section class="panel" aria-labelledby="queueTitle">
            <div class="panel-header">
              <h2 class="panel-title" id="queueTitle">Queue</h2>
              <span class="chip" id="queueState">Idle</span>
            </div>
            <div class="panel-body form-grid">
              <div class="current-job">
                <span class="small">Current</span>
                <strong id="currentJob">No active job</strong>
                <span class="small" id="currentRepeat">Repeat -</span>
              </div>
              <div class="queue-grid">
                <div class="metric"><span>Elapsed</span><strong id="elapsedTime">00:00</strong></div>
                <div class="metric"><span>Total</span><strong id="totalJobs">0</strong></div>
                <div class="metric"><span>Complete</span><strong id="completedJobs">0</strong></div>
                <div class="metric"><span>Failed</span><strong id="failedJobs">0</strong></div>
                <div class="metric"><span>Pending</span><strong id="pendingJobs">0</strong></div>
                <div class="metric"><span>Skipped</span><strong id="skippedJobs">0</strong></div>
              </div>
            </div>
          </section>

          <section class="panel" aria-labelledby="statsTitle">
            <div class="panel-header">
              <h2 class="panel-title" id="statsTitle">System</h2>
              <span class="chip" id="statsTimestamp">Unavailable</span>
            </div>
            <div class="panel-body form-grid" id="statsPanel">
              <div class="stats-grid">
                <div class="metric"><span>CPU</span><strong id="cpuStat">Unavailable</strong></div>
                <div class="metric"><span>Load</span><strong id="loadStat">Unavailable</strong></div>
                <div class="metric"><span>Memory</span><strong id="memoryStat">Unavailable</strong></div>
                <div class="metric"><span>GPU</span><strong id="gpuStat">Unavailable</strong></div>
              </div>
              <div class="small" id="statsMessage">Waiting for system stats.</div>
            </div>
          </section>
        </div>
      </div>
    </main>

    <div class="detail-backdrop" id="detailBackdrop" role="presentation">
      <section class="detail-dialog" role="dialog" aria-modal="true" aria-label="Run detail">
        <div class="panel-header">
          <h2 class="panel-title" id="detailTitle">Run detail</h2>
          <button type="button" id="closeDetail">Close</button>
        </div>
        <div class="detail-body">
          <div class="stack">
            <div class="preview" id="detailPreview">No preview</div>
            <div>
              <div class="label-row"><span>Prompt</span></div>
              <pre id="detailPrompt"></pre>
            </div>
          </div>
          <aside class="stack">
            <div class="kv" id="detailMeta"></div>
            <div class="link-row">
              <a id="rawLink" href="#">Raw response</a>
              <a id="htmlLink" href="#">Open HTML</a>
            </div>
            <pre id="rawPreview"></pre>
          </aside>
        </div>
      </section>
    </div>

    <script is:inline>
      const DEFAULT_BASE_URL = "http://localhost:1234/v1";

      const state = {
        benchmarks: [],
        models: [],
        runs: [],
        queue: null,
        stats: null,
        selectedBenchmarks: new Set(),
        selectedModels: new Set(),
        media: "image",
        queueStartedAt: null
      };

      const els = {
        baseUrl: document.querySelector("#baseUrl"),
        testConnection: document.querySelector("#testConnection"),
        connectionPill: document.querySelector("#connectionPill"),
        connectionLabel: document.querySelector("#connectionLabel"),
        connectionMessage: document.querySelector("#connectionMessage"),
        modelList: document.querySelector("#modelList"),
        modelCount: document.querySelector("#modelCount"),
        modelListCount: document.querySelector("#modelListCount"),
        benchmarkList: document.querySelector("#benchmarkList"),
        benchmarkCount: document.querySelector("#benchmarkCount"),
        benchmarkListCount: document.querySelector("#benchmarkListCount"),
        repeatCount: document.querySelector("#repeatCount"),
        captureAtMs: document.querySelector("#captureAtMs"),
        videoGeneration: document.querySelector("#videoGeneration"),
        matrixSize: document.querySelector("#matrixSize"),
        startQueue: document.querySelector("#startQueue"),
        stopQueue: document.querySelector("#stopQueue"),
        cancelQueue: document.querySelector("#cancelQueue"),
        queueMessage: document.querySelector("#queueMessage"),
        queueState: document.querySelector("#queueState"),
        currentJob: document.querySelector("#currentJob"),
        currentRepeat: document.querySelector("#currentRepeat"),
        elapsedTime: document.querySelector("#elapsedTime"),
        totalJobs: document.querySelector("#totalJobs"),
        completedJobs: document.querySelector("#completedJobs"),
        failedJobs: document.querySelector("#failedJobs"),
        pendingJobs: document.querySelector("#pendingJobs"),
        skippedJobs: document.querySelector("#skippedJobs"),
        statsTimestamp: document.querySelector("#statsTimestamp"),
        cpuStat: document.querySelector("#cpuStat"),
        loadStat: document.querySelector("#loadStat"),
        memoryStat: document.querySelector("#memoryStat"),
        gpuStat: document.querySelector("#gpuStat"),
        statsMessage: document.querySelector("#statsMessage"),
        resultsGrid: document.querySelector("#resultsGrid"),
        runCount: document.querySelector("#runCount"),
        detailBackdrop: document.querySelector("#detailBackdrop"),
        closeDetail: document.querySelector("#closeDetail"),
        detailTitle: document.querySelector("#detailTitle"),
        detailPreview: document.querySelector("#detailPreview"),
        detailPrompt: document.querySelector("#detailPrompt"),
        detailMeta: document.querySelector("#detailMeta"),
        rawLink: document.querySelector("#rawLink"),
        htmlLink: document.querySelector("#htmlLink"),
        rawPreview: document.querySelector("#rawPreview")
      };

      init();

      function init() {
        wireEvents();
        renderQueue(idleQueue());
        void refreshAll();
        setInterval(tickElapsed, 1000);
      }

      function wireEvents() {
        els.testConnection.addEventListener("click", () => testConnection());
        els.startQueue.addEventListener("click", () => startQueue());
        els.stopQueue.addEventListener("click", () => queueCommand("/api/queue/stop-after-current", "Stop requested."));
        els.cancelQueue.addEventListener("click", () => queueCommand("/api/queue/cancel-now", "Cancel requested."));
        els.repeatCount.addEventListener("input", renderMatrixSize);
        els.captureAtMs.addEventListener("input", renderMatrixSize);
        els.videoGeneration.addEventListener("change", renderMatrixSize);
        els.closeDetail.addEventListener("click", closeDetail);
        els.detailBackdrop.addEventListener("click", (event) => {
          if (event.target === els.detailBackdrop) {
            closeDetail();
          }
        });
        document.querySelectorAll("[data-media]").forEach((button) => {
          button.addEventListener("click", () => {
            state.media = button.dataset.media;
            document.querySelectorAll("[data-media]").forEach((candidate) => {
              candidate.setAttribute("aria-pressed", String(candidate === button));
            });
            renderRuns();
          });
        });
      }

      async function refreshAll() {
        await Promise.all([loadBenchmarks(), loadStats(), loadRuns(), testConnection(false)]);
      }

      async function loadBenchmarks() {
        try {
          const data = await fetchJson("/api/benchmarks");
          state.benchmarks = data.benchmarks ?? [];
          state.selectedBenchmarks = new Set(state.benchmarks.map((benchmark) => benchmark.id));
          renderBenchmarks();
        } catch (error) {
          els.benchmarkList.innerHTML = `<div class="empty">Benchmarks unavailable</div>`;
          els.benchmarkCount.textContent = "Benchmarks unavailable";
          setMessage(els.queueMessage, error.message, "error");
        }
      }

      async function testConnection(showMessage = true) {
        const baseUrl = els.baseUrl.value.trim() || DEFAULT_BASE_URL;
        setConnection("checking", "Checking", showMessage ? "Testing LM Studio." : "Checking local LM Studio.");

        try {
          const data = await fetchJson(`/api/status?baseUrl=${encodeURIComponent(baseUrl)}`);
          const connection = data.lmStudio?.connection;
          renderQueue(data.queue ?? idleQueue());

          if (connection?.ok) {
            setConnection("online", "Online", "LM Studio reachable.");
            await loadModels(baseUrl);
            return;
          }

          state.models = [];
          state.selectedModels = new Set();
          renderModels();
          setConnection("offline", "Offline", "Connection unavailable. " + (connection?.error ?? ""));
        } catch (error) {
          state.models = [];
          state.selectedModels = new Set();
          renderModels();
          setConnection("error", "Offline", "Connection unavailable. " + error.message);
        }
      }

      async function loadModels(baseUrl) {
        try {
          const data = await fetchJson(`/api/lmstudio/models?baseUrl=${encodeURIComponent(baseUrl)}`);
          state.models = data.models ?? [];
          state.selectedModels = new Set(state.models.map((model) => model.id));
          renderModels();
        } catch (error) {
          state.models = [];
          state.selectedModels = new Set();
          renderModels();
          setConnection("error", "Offline", "Connection unavailable. " + error.message);
        }
      }

      async function loadStats() {
        try {
          const data = await fetchJson("/api/system-stats");
          state.stats = data.stats;
          renderStats();
        } catch (error) {
          els.statsMessage.textContent = error.message;
        }
      }

      async function loadRuns() {
        try {
          const data = await fetchJson("/api/runs");
          state.runs = data.runs ?? [];
          renderRuns();
        } catch {
          state.runs = [];
          renderRuns();
        }
      }

      async function startQueue() {
        const benchmarkIds = [...state.selectedBenchmarks];
        const modelIds = [...state.selectedModels];

        if (benchmarkIds.length === 0 || modelIds.length === 0) {
          setMessage(els.queueMessage, "Select at least one benchmark and one model.", "error");
          return;
        }

        const payload = {
          benchmarkIds,
          modelIds,
          repeatCount: readPositiveInteger(els.repeatCount.value, 1),
          capture: {
            preview: {
              captureAtMs: readPositiveInteger(els.captureAtMs.value, 0),
              video: els.videoGeneration.checked
            }
          },
          baseUrl: els.baseUrl.value.trim() || DEFAULT_BASE_URL
        };

        try {
          const data = await postJson("/api/queue/start", payload);
          state.queueStartedAt = Date.now();
          renderQueue(data.queue);
          setMessage(els.queueMessage, "Queue started.", "");
          void loadRuns();
        } catch (error) {
          setMessage(els.queueMessage, error.message, "error");
        }
      }

      async function queueCommand(url, message) {
        try {
          const data = await postJson(url, {});
          renderQueue(data.queue);
          setMessage(els.queueMessage, message, "");
        } catch (error) {
          setMessage(els.queueMessage, error.message, "error");
        }
      }

      function renderBenchmarks() {
        els.benchmarkCount.textContent = `${state.benchmarks.length} benchmarks`;
        els.benchmarkListCount.textContent = String(state.benchmarks.length);

        if (state.benchmarks.length === 0) {
          els.benchmarkList.innerHTML = `<div class="empty">No benchmarks found</div>`;
          renderMatrixSize();
          return;
        }

        els.benchmarkList.replaceChildren(
          ...state.benchmarks.map((benchmark) => {
            const label = document.createElement("label");
            label.className = "check-row";
            label.innerHTML = `
              <input type="checkbox" value="${escapeHtml(benchmark.id)}" checked />
              <span>
                <span class="check-title">${escapeHtml(benchmark.title)}</span>
                <span class="check-desc">${escapeHtml(benchmark.description)}</span>
              </span>
            `;
            const input = label.querySelector("input");
            input.addEventListener("change", () => {
              updateSelection(state.selectedBenchmarks, benchmark.id, input.checked);
              renderMatrixSize();
            });
            return label;
          })
        );
        renderMatrixSize();
      }

      function renderModels() {
        els.modelCount.textContent = `${state.models.length} models`;
        els.modelListCount.textContent = String(state.models.length);

        if (state.models.length === 0) {
          els.modelList.innerHTML = `<div class="empty">No models discovered</div>`;
          renderMatrixSize();
          return;
        }

        els.modelList.replaceChildren(
          ...state.models.map((model) => {
            const label = document.createElement("label");
            label.className = "check-row";
            label.innerHTML = `
              <input type="checkbox" value="${escapeHtml(model.id)}" checked />
              <span>
                <span class="check-title">${escapeHtml(model.id)}</span>
                <span class="check-desc">LM Studio model</span>
              </span>
            `;
            const input = label.querySelector("input");
            input.addEventListener("change", () => {
              updateSelection(state.selectedModels, model.id, input.checked);
              renderMatrixSize();
            });
            return label;
          })
        );
        renderMatrixSize();
      }

      function renderMatrixSize() {
        const repeats = readPositiveInteger(els.repeatCount.value, 1);
        const count = state.selectedBenchmarks.size * state.selectedModels.size * repeats;
        els.matrixSize.textContent = `${count} ${count === 1 ? "job" : "jobs"}`;
      }

      function renderQueue(queue) {
        state.queue = queue ?? idleQueue();
        const active = state.queue.activeJob;
        const status = titleCase(state.queue.status);

        els.queueState.textContent = status;
        els.currentJob.textContent = active ? `${active.benchmark.id} / ${active.model.id}` : "No active job";
        els.currentRepeat.textContent = active ? `Repeat ${active.repeatIndex} of ${active.repeatTotal}` : "Repeat -";
        els.totalJobs.textContent = String(state.queue.totalJobs ?? 0);
        els.completedJobs.textContent = String(state.queue.completedJobs?.length ?? 0);
        els.failedJobs.textContent = String(state.queue.failedJobs?.length ?? 0);
        els.pendingJobs.textContent = String(state.queue.pendingJobs?.length ?? 0);
        els.skippedJobs.textContent = String(state.queue.skippedJobs?.length ?? 0);
        els.stopQueue.disabled = !(state.queue.status === "running");
        els.cancelQueue.disabled = !(state.queue.status === "running" || state.queue.status === "stopping");

        if (active && !state.queueStartedAt) {
          state.queueStartedAt = Date.now();
        }
        if (!active && state.queue.status !== "running" && state.queue.status !== "stopping") {
          state.queueStartedAt = null;
        }
        tickElapsed();
      }

      function renderStats() {
        const stats = state.stats;
        if (!stats) {
          return;
        }

        els.statsTimestamp.textContent = new Date(stats.collectedAt).toLocaleTimeString();
        els.cpuStat.textContent = `${stats.cpu?.cores ?? "-"} cores`;
        els.loadStat.textContent = (stats.cpu?.loadAverage ?? []).slice(0, 3).map((value) => value.toFixed(2)).join(" / ") || "Unavailable";
        els.memoryStat.textContent = `${formatBytes(stats.memory?.usedBytes)} / ${formatBytes(stats.memory?.totalBytes)}`;
        els.gpuStat.textContent = stats.gpu?.available ? `${stats.gpu.devices.length} devices` : "Unavailable";
        els.statsMessage.textContent = stats.gpu?.available ? `${stats.os?.type ?? "OS"} ${stats.os?.release ?? ""}` : stats.gpu?.reason ?? "GPU telemetry unavailable.";
      }

      function renderRuns() {
        els.runCount.textContent = `${state.runs.length} ${state.runs.length === 1 ? "run" : "runs"}`;

        if (state.runs.length === 0) {
          els.resultsGrid.innerHTML = `<div class="empty">No runs yet</div>`;
          return;
        }

        els.resultsGrid.replaceChildren(
          ...state.runs.map((run) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "run-card";
            button.innerHTML = `
              ${renderPreview(run, state.media)}
              <span class="run-meta">
                <strong>${escapeHtml(run.benchmark?.title ?? run.benchmark?.id ?? "Untitled run")}</strong>
                <span class="small">${escapeHtml(run.model?.id ?? "Unknown model")}</span>
                <span class="chip">${escapeHtml(run.status ?? "unknown")}</span>
              </span>
            `;
            button.addEventListener("click", () => openDetail(run));
            return button;
          })
        );
      }

      function renderPreview(run, media) {
        const previewHref = assetHref(run, run.assets?.preview);
        const videoHref = assetHref(run, run.assets?.video);

        if (media === "video" && videoHref) {
          return `<span class="preview"><video src="${escapeAttribute(videoHref)}" muted loop playsinline></video></span>`;
        }

        const fallback = media === "video" && !videoHref ? `<span class="fallback-note">Video missing, showing PNG</span>` : "";
        if (previewHref) {
          return `<span class="preview"><img src="${escapeAttribute(previewHref)}" alt="" />${fallback}</span>`;
        }

        return `<span class="preview">No preview${fallback}</span>`;
      }

      function openDetail(run) {
        els.detailTitle.textContent = `${run.benchmark?.title ?? "Run detail"}`;
        els.detailPreview.innerHTML = renderPreview(run, state.media);
        els.detailPrompt.textContent = run.benchmark?.prompt ?? "Prompt unavailable.";
        els.detailMeta.innerHTML = `
          <span>Status</span><strong>${escapeHtml(run.status ?? "unknown")}</strong>
          <span>Run ID</span><strong>${escapeHtml(run.runId ?? "-")}</strong>
          <span>Model</span><strong>${escapeHtml(run.model?.id ?? "-")}</strong>
          <span>Benchmark</span><strong>${escapeHtml(run.benchmark?.id ?? "-")}</strong>
          <span>Updated</span><strong>${escapeHtml(formatDate(run.updatedAt))}</strong>
          <span>Capture</span><strong>${escapeHtml(String(run.settings?.preview?.captureAtMs ?? "-"))} ms</strong>
        `;
        els.rawLink.href = assetHref(run, run.assets?.rawResponse) ?? "#";
        els.htmlLink.href = assetHref(run, run.assets?.html) ?? "#";
        els.rawPreview.textContent = run.assets?.rawResponse
          ? `Raw response: ${assetPath(run, run.assets.rawResponse)}`
          : "Raw response unavailable.";
        els.detailBackdrop.setAttribute("open", "");
      }

      function closeDetail() {
        els.detailBackdrop.removeAttribute("open");
      }

      function setConnection(stateName, label, message) {
        els.connectionPill.dataset.state = stateName;
        els.connectionPill.textContent = label;
        els.connectionLabel.textContent = label;
        setMessage(els.connectionMessage, message, stateName === "offline" || stateName === "error" ? "error" : "");
      }

      function setMessage(element, message, tone) {
        element.textContent = message ?? "";
        element.dataset.tone = tone ?? "";
      }

      function tickElapsed() {
        if (!state.queueStartedAt) {
          els.elapsedTime.textContent = "00:00";
          return;
        }
        const elapsedSeconds = Math.max(0, Math.floor((Date.now() - state.queueStartedAt) / 1000));
        const minutes = String(Math.floor(elapsedSeconds / 60)).padStart(2, "0");
        const seconds = String(elapsedSeconds % 60).padStart(2, "0");
        els.elapsedTime.textContent = `${minutes}:${seconds}`;
      }

      async function fetchJson(url) {
        const response = await fetch(url);
        return readJsonResponse(response);
      }

      async function postJson(url, body) {
        const response = await fetch(url, {
          method: "POST",
          headers: {
            "content-type": "application/json"
          },
          body: JSON.stringify(body)
        });
        return readJsonResponse(response);
      }

      async function readJsonResponse(response) {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error?.message ?? `Request failed with HTTP ${response.status}.`);
        }
        return data;
      }

      function updateSelection(set, value, selected) {
        if (selected) {
          set.add(value);
        } else {
          set.delete(value);
        }
      }

      function readPositiveInteger(value, fallback) {
        const parsed = Number.parseInt(value, 10);
        return Number.isFinite(parsed) && parsed >= fallback ? parsed : fallback;
      }

      function idleQueue() {
        return {
          status: "idle",
          pendingJobs: [],
          completedJobs: [],
          failedJobs: [],
          skippedJobs: [],
          totalJobs: 0
        };
      }

      function assetPath(run, asset) {
        if (!asset || !run.runDirectory) {
          return "";
        }
        return `${String(run.runDirectory).replace(/\/+$/u, "")}/${asset}`;
      }

      function assetHref(run, asset) {
        const path = assetPath(run, asset);
        if (!path) {
          return null;
        }
        if (/^[a-z][a-z0-9+.-]*:/iu.test(path)) {
          return path;
        }
        return `file://${path.split("/").map(encodeURIComponent).join("/")}`;
      }

      function formatBytes(value) {
        if (!Number.isFinite(value)) {
          return "Unavailable";
        }
        const units = ["B", "KB", "MB", "GB", "TB"];
        let size = value;
        let unitIndex = 0;
        while (size >= 1024 && unitIndex < units.length - 1) {
          size /= 1024;
          unitIndex += 1;
        }
        return `${size.toFixed(unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
      }

      function formatDate(value) {
        return value ? new Date(value).toLocaleString() : "-";
      }

      function titleCase(value) {
        return String(value ?? "").replace(/^\w/u, (match) => match.toUpperCase());
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/gu, "&amp;")
          .replace(/</gu, "&lt;")
          .replace(/>/gu, "&gt;")
          .replace(/"/gu, "&quot;");
      }

      function escapeAttribute(value) {
        return escapeHtml(value).replace(/'/gu, "&#39;");
      }
    </script>
  </body>
</html>

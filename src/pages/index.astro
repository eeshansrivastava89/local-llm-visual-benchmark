---
import "../styles/global.css";

const title = "Local LLM Visual Benchmark";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="mx-auto flex min-h-14 w-full max-w-[1600px] items-center gap-4 px-4 md:px-5">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <div class="grid size-8 place-items-center rounded-lg border bg-card text-xs font-semibold shadow-sm">
              LV
            </div>
            <div class="min-w-0">
              <h1 class="truncate-line text-sm font-semibold tracking-[-0.01em]">
                Local LLM Visual Benchmark
              </h1>
              <p class="muted-copy truncate-line text-xs">
                Browse and collect visual benchmark outputs.
              </p>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <span class="badge-outline gap-1.5 text-xs" id="statsPill" title="System stats">
              <span id="statsDot" class="status-dot" data-state="offline"></span>
              <span id="statsCompact">Loading…</span>
            </span>
            <button type="button" class="btn-sm-outline" id="setupToggle">How it works</button>
            <button type="button" class="btn-sm-outline" id="lmStudioToggle">LM Studio</button>
            <button type="button" class="btn" id="runToggle">Prepare run</button>
          </div>
        </div>
      </header>

      <main class="mx-auto w-full max-w-[1600px] px-4 py-4 md:px-5 md:py-5">
        <div class="grid gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <div class="dropdown-wrap">
              <select id="modelFilter" class="input text-sm" aria-label="Filter by model">
                <option value="all">All run models</option>
              </select>
            </div>
            <div class="dropdown-wrap">
              <select id="benchmarkFilter" class="input text-sm" aria-label="Filter by prompt">
                <option value="all">All prompts</option>
              </select>
            </div>
            <div class="inline-flex rounded-lg border bg-muted p-0.5">
              <button type="button" class="btn-sm-ghost" data-mode="gallery" aria-pressed="true">Gallery</button>
              <button type="button" class="btn-sm-ghost" data-mode="model">By model</button>
              <button type="button" class="btn-sm-ghost" data-mode="benchmark">By prompt</button>
            </div>
            <button type="button" class="btn-sm-outline ml-auto" id="refreshRuns">Refresh</button>
          </div>

          <div class="gallery-summary">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h2 id="viewTitle" class="text-lg font-semibold tracking-[-0.01em]">Run gallery</h2>
                <span class="badge-outline" id="runCount">0</span>
              </div>
              <p class="muted-copy mt-0.5 text-sm" id="viewSubtitle">Browse saved visual outputs.</p>
              <p class="muted-copy text-sm" id="runSummary">Loading saved runs.</p>
            </div>
          </div>

          <div id="runsSurface"></div>
        </div>
      </main>
    </div>

    <!-- Detail Modal -->
    <div class="detail-backdrop" id="detailBackdrop">
      <article class="detail-shell" role="dialog" aria-modal="true" aria-label="Run detail">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 id="detailTitle" class="truncate-line text-lg font-semibold">Run detail</h2>
            <p class="muted-copy truncate-line mt-1 text-sm" id="detailSubtitle"></p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeDetail">Close</button>
        </header>
        <div class="detail-body p-5">
          <div class="grid min-w-0 gap-4">
            <div id="detailPreview"></div>
            <div class="detail-actions" id="detailActions">
              <a class="btn-sm-outline" id="htmlLink" href="#" target="_blank" rel="noreferrer">Open HTML</a>
              <a class="btn-sm-outline" id="promptLink" href="#" target="_blank" rel="noreferrer">Prompt file</a>
              <a class="btn-sm-outline" id="rawLink" href="#" target="_blank" rel="noreferrer">Raw response</a>
            </div>
          </div>
          <aside class="detail-inspector">
            <div class="run-identity">
              <div class="meta-grid" id="detailMeta"></div>
            </div>
            <section class="inspector-section">
              <div class="section-row">
                <h3>Prompt</h3>
                <span class="badge-outline" id="promptLength">0 chars</span>
              </div>
              <pre class="code-block prompt-block" id="detailPrompt"></pre>
            </section>
            <section class="inspector-section compact-section">
              <div class="section-row">
                <h3>Filesystem</h3>
              </div>
              <pre class="code-block paths-block" id="detailPaths"></pre>
            </section>
          </aside>
        </div>
      </article>
    </div>

    <!-- Prepare Run Modal -->
    <div class="detail-backdrop" id="prepBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="Prepare run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Prepare run slot</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Choose a prompt and model to generate a run folder.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closePrep">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="grid gap-4">
            <div class="grid gap-2">
              <label for="prepBenchmark">Prompt</label>
              <select id="prepBenchmark" class="input"></select>
            </div>
            <div class="grid gap-2">
              <label for="prepModelSelect">Discovered model</label>
              <select id="prepModelSelect" class="input"></select>
            </div>
            <div class="grid gap-2">
              <label for="prepModel">Model ID</label>
              <input id="prepModel" class="input" placeholder="google/gemma-4-e4b" />
            </div>
            <button class="btn w-full" type="button" id="prepareRun">Prepare slot</button>
            <p class="muted-copy text-sm leading-5" id="prepMessage">The app will create the folder, metadata.json, and prompt.md.</p>

            <div id="prepResult" class="grid gap-3" hidden>
              <div class="next-step-panel">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sm font-medium">Generated prompt</h3>
                  <button type="button" class="btn-sm-outline" id="copyPrompt">Copy</button>
                </div>
                <textarea
                  id="preparedPrompt"
                  class="input min-h-48 resize-y font-mono text-[0.82rem] leading-5"
                  readonly
                ></textarea>
                <p class="muted-copy text-sm" id="preparedPaths"></p>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Setup / How it works Modal -->
    <div class="detail-backdrop" id="setupBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="How it works">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">How it works</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Three steps from prompt to saved artifact.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeSetup">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="grid gap-6">
            <!-- 1-2-3 Steps -->
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl bg-muted p-4">
                <span class="badge-outline mb-3">1</span>
                <h3 class="font-medium">Create a slot</h3>
                <p class="muted-copy mt-1 text-sm leading-5">Pick a prompt and model. The app writes a run folder with metadata and a paste-ready prompt.</p>
              </div>
              <div class="rounded-xl bg-muted p-4">
                <span class="badge-outline mb-3">2</span>
                <h3 class="font-medium">Run externally</h3>
                <p class="muted-copy mt-1 text-sm leading-5">Paste the prompt into OpenCode, Pi, or another tool. Save the HTML to the exact path in the folder.</p>
              </div>
              <div class="rounded-xl bg-muted p-4">
                <span class="badge-outline mb-3">3</span>
                <h3 class="font-medium">Refresh and inspect</h3>
                <p class="muted-copy mt-1 text-sm leading-5">Refresh the gallery when files land. Open any run card to inspect the artifact, prompt, and paths.</p>
              </div>
            </div>

            <!-- OpenCode Setup -->
            <div class="grid gap-3">
              <div class="flex items-center gap-2">
                <h3 class="text-base font-semibold">OpenCode Setup</h3>
                <a href="https://opencode.ai" target="_blank" rel="noreferrer" class="btn-sm-outline text-xs">Install OpenCode</a>
              </div>
              <p class="muted-copy text-sm leading-5">Add LM Studio as a provider in <code class="text-xs bg-muted px-1.5 py-0.5 rounded">~/.config/opencode/opencode.json</code>:</p>
              <pre class="code-block">{'{'}
  "provider": {'{'}
    "lmstudio": {'{'}
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {'{'}
        "apiKey": "lm-studio",
        "baseURL": "http://127.0.0.1:1234/v1"
      {'}'},
      "models": {'{'}
        "model-id": {'{'}
          "name": "display-name"
        {'}'}
      {'}'}
    {'}'}
  {'}'}
{'}'}</pre>
            </div>

            <!-- Pi Setup -->
            <div class="grid gap-3">
              <div class="flex items-center gap-2">
                <h3 class="text-base font-semibold">Pi Setup</h3>
                <a href="https://pi.dev" target="_blank" rel="noreferrer" class="btn-sm-outline text-xs">Install Pi</a>
              </div>
              <p class="muted-copy text-sm leading-5">Add LM Studio as a provider in <code class="text-xs bg-muted px-1.5 py-0.5 rounded">~/.pi/agent/models.json</code>:</p>
              <pre class="code-block">{'{'}
  "providers": {'{'}
    "lmstudio": {'{'}
      "baseUrl": "http://127.0.0.1:1234/v1",
      "api": "openai-completions",
      "apiKey": "lm-studio",
      "compat": {'{'}
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      {'}'},
      "models": [
        {'{'}
          "id": "model-id",
          "name": "display-name",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 262144,
          "maxTokens": 32768
        {'}'}
      ]
    {'}'}
  {'}'}
{'}'}</pre>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- LM Studio Modal -->
    <div class="detail-backdrop" id="lmStudioBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="LM Studio">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">LM Studio</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Passive discovery of local models.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeLmStudio">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="grid gap-4">
            <div class="grid gap-2">
              <label for="baseUrl" class="section-label">Base URL</label>
              <div class="flex gap-2">
                <input id="baseUrl" class="input flex-1" aria-label="LM Studio base URL" value="http://localhost:1234/v1" />
                <button type="button" class="btn-sm-outline" id="refreshConnection">Test</button>
              </div>
            </div>
            <p class="muted-copy text-sm leading-5" id="connectionMessage">Waiting for local API.</p>
            <div class="grid gap-2">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Current LM Studio models</h3>
                <span class="badge-outline" id="availableModelCount">0</span>
              </div>
              <div class="available-model-list" id="availableModelChoices"></div>
            </div>
            <div class="grid gap-2">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Run models from filesystem</h3>
                <span class="badge-outline" id="runModelCount">0</span>
              </div>
              <div class="available-model-list" id="runModelChoices"></div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <script is:inline src="viewer.js"></script>
  </body>
</html>

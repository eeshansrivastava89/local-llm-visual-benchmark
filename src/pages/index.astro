---
import "../styles/global.css";

const title = "Local LLM Visual Benchmark";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="mx-auto flex min-h-14 w-full max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <div class="grid size-8 place-items-center rounded-lg border bg-card text-xs font-semibold shadow-sm">
              LV
            </div>
            <div class="min-w-0">
              <h1 class="truncate-line text-sm font-semibold tracking-[-0.01em]">
                Local LLM Visual Benchmark
              </h1>
              <p class="muted-copy truncate-line text-xs">
                Browse and collect visual benchmark outputs.
              </p>
            </div>
          </div>

          <a class="sidequest-attribution" href="https://eeshans.com/" target="_blank" rel="noopener">
            a side quest by <span>eeshans.com</span>
          </a>

          <div class="flex shrink-0 items-center gap-2">
            <span class="badge-outline gap-1.5 text-xs operational-control" id="statsPill" title="System stats">
              <span id="statsDot" class="status-dot" data-state="offline"></span>
              <span id="statsCompact">Loading…</span>
            </span>
            <button type="button" class="btn-sm-outline icon-only-btn" id="themeToggle" aria-label="Use dark theme" title="Use dark theme">
              <span id="themeIcon" aria-hidden="true">☾</span>
              <span class="sr-only" id="themeLabel">Dark</span>
            </button>
            <button type="button" class="btn-sm-outline operational-control" id="setupToggle">Setup</button>
            <button type="button" class="btn operational-control" id="runToggle">Prepare run</button>
          </div>
        </div>
      </header>

      <main class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6 lg:px-8 md:py-5">
        <div class="grid gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-lg border bg-muted p-0.5">
              <button type="button" class="btn-sm-ghost" data-mode="model" aria-pressed="true">By model</button>
              <button type="button" class="btn-sm-ghost" data-mode="benchmark" aria-pressed="false">By prompt</button>
              <button type="button" class="btn-sm-ghost" data-mode="gallery" aria-pressed="false">Gallery</button>
            </div>
            <div class="dropdown-wrap">
              <select id="modelFilter" class="input text-sm" aria-label="Filter by model">
                <option value="all">All run models</option>
              </select>
            </div>
            <div class="dropdown-wrap">
              <select id="benchmarkFilter" class="input text-sm" aria-label="Filter by prompt">
                <option value="all">All prompts</option>
              </select>
            </div>
            <button type="button" class="btn-sm-outline ml-auto operational-control" id="captureMedia">Capture media</button>
            <button type="button" class="btn-sm-outline operational-control" id="refreshRuns">Refresh</button>
          </div>

          <div class="gallery-summary">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h2 id="viewTitle" class="text-lg font-semibold tracking-[-0.01em]">Run gallery</h2>
                <span class="badge-outline" id="runCount">0</span>
              </div>
              <p class="muted-copy mt-0.5 text-sm" id="viewSubtitle">Browse saved visual outputs.</p>
              <p class="muted-copy text-sm" id="runSummary">Loading saved runs.</p>
            </div>
          </div>

          <div id="runsSurface"></div>
        </div>
      </main>

      <footer class="footer" role="contentinfo">
        <span>&copy; 2025&ndash;2026 Eeshan Srivastava</span>
        <span>Personal project &middot; MIT License &middot; Non-commercial</span>
        <span class="footer-links">
          <a
            href="https://github.com/eeshansrivastava89/local-llm-visual-benchmark"
            target="_blank"
            rel="noopener noreferrer"
          >
            Source
          </a>
          <a href="https://www.linkedin.com/in/eeshans/" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        </span>
      </footer>
    </div>

    <!-- Detail Modal -->
    <div class="detail-backdrop" id="detailBackdrop">
      <article class="detail-shell" role="dialog" aria-modal="true" aria-label="Run detail">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 id="detailTitle" class="truncate-line text-lg font-semibold">Run detail</h2>
            <p class="muted-copy truncate-line mt-1 text-sm" id="detailSubtitle"></p>
          </div>
          <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
            <button type="button" class="btn-sm-outline operational-control" id="openHtml" data-operational-available="false">Open HTML</button>
            <button type="button" class="btn-sm-outline operational-control" id="recaptureRun" data-operational-available="false">Recapture media</button>
            <button type="button" class="btn-sm-danger operational-control" id="deleteRun" data-operational-available="false">Delete run</button>
            <button type="button" class="btn-sm-outline" id="closeDetail">Close</button>
          </div>
        </header>
        <div class="detail-body p-5">
          <div class="grid min-w-0">
            <div id="detailPreview"></div>
          </div>
          <aside class="detail-inspector">
            <div class="run-identity">
              <div class="meta-grid" id="detailMeta"></div>
            </div>
            <section class="inspector-section">
              <div class="section-row">
                <h3>Prompt</h3>
                <div class="section-actions">
                  <span class="badge-outline" id="promptLength">0 chars</span>
                  <button type="button" class="btn-sm-outline" id="copyDetailPrompt">Copy prompt</button>
                </div>
              </div>
              <pre class="code-block prompt-block" id="detailPrompt"></pre>
            </section>
            <section class="inspector-section compact-section run-folder-section">
              <div class="section-row">
                <h3>Run folder</h3>
                <button type="button" class="btn-sm-outline" id="copyRunFolder">Copy path</button>
              </div>
              <div class="run-folder-path-wrap">
                <code class="run-folder-path" id="detailRunFolderPath">-</code>
              </div>
            </section>
          </aside>
        </div>
      </article>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="detail-backdrop" id="deleteConfirmBackdrop">
      <article class="confirm-shell" role="dialog" aria-modal="true" aria-label="Delete run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Delete run?</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">This removes the run folder from disk.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeDeleteConfirm">Close</button>
        </header>
        <div class="grid gap-4 p-5">
          <div class="rounded-lg border border-[oklch(0.78_0.06_28)] bg-[oklch(0.97_0.018_28)] p-3">
            <p class="text-sm font-medium text-[oklch(0.45_0.12_28)]">This cannot be undone.</p>
            <p class="muted-copy mt-1 text-sm leading-5">The whole run folder will be deleted, including metadata, prompt, HTML, preview, and raw response files.</p>
          </div>
          <div class="grid gap-1">
            <span class="section-label">Run folder</span>
            <code class="code-inline-path" id="deleteRunPath"></code>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button type="button" class="btn-sm-outline" id="cancelDeleteRun">Cancel</button>
            <button type="button" class="btn-sm-danger" id="confirmDeleteRun">Delete folder</button>
          </div>
        </div>
      </article>
    </div>

    <!-- Prepare Run Modal -->
    <div class="detail-backdrop" id="prepBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="Prepare run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Prepare run slot</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Choose a prompt and model to generate a run folder.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closePrep">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="prep-layout" id="prepLayout">
            <section class="prep-form-panel" aria-label="Run slot inputs">
              <div class="grid gap-2">
                <label for="prepBenchmark">Prompt</label>
                <select id="prepBenchmark" class="input"></select>
              </div>
              <div class="grid gap-2">
                <label for="prepModelSelect">Discovered model</label>
                <select id="prepModelSelect" class="input"></select>
              </div>
              <button class="btn w-full" type="button" id="prepareRun">Prepare slot</button>
              <p class="muted-copy text-sm leading-5" id="prepMessage">The app will create the folder, metadata.json, and prompt.md.</p>
            </section>

            <section id="prepResult" class="next-step-panel prep-prompt-panel" aria-label="Generated prompt">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <h3 class="text-sm font-medium">Generated prompt</h3>
                  <p class="muted-copy mt-0.5 text-xs">Copy this into your external tool after preparing the slot.</p>
                </div>
                <button type="button" class="btn-sm-outline" id="copyPrompt" disabled>Copy</button>
              </div>
              <textarea
                id="preparedPrompt"
                class="input font-mono text-[0.82rem] leading-5"
                placeholder="Prepare a run slot to generate the exact prompt and output path."
                readonly
              ></textarea>
              <p class="muted-copy text-sm" id="preparedPaths">No run slot prepared yet.</p>
            </section>
          </div>
        </div>
      </article>
    </div>

    <!-- Setup Modal -->
    <div class="detail-backdrop" id="setupBackdrop">
      <article class="prep-shell lm-studio-shell" role="dialog" aria-modal="true" aria-label="Setup">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Setup</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Configure LM Studio, then prepare runs and save generated artifacts.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeSetup">Close</button>
        </header>
        <div class="prep-body setup-body">
          <div class="setup-console-layout">
            <section class="lm-source-panel" aria-labelledby="lmStudioHeading">
              <div class="lm-source-heading">
                <div class="min-w-0">
                  <span class="section-label">Local model source</span>
                  <h3 id="lmStudioHeading">LM Studio</h3>
                  <p>Discover live models, then mirror that list into Pi and OpenCode when needed.</p>
                </div>
                <span class="badge-outline lm-count-badge"><span id="availableModelCount">0</span> models</span>
              </div>

              <div class="lm-operations-grid">
                <div id="lmStep1" class="lm-op-cell lm-connect-cell">
                  <div class="lm-op-head">
                    <span class="lm-op-title">Connection</span>
                    <span class="section-label">LM Studio URL</span>
                  </div>
                  <div class="lm-op-control lm-connect-control">
                    <input id="baseUrl" class="input flex-1" aria-label="LM Studio base URL" value="http://localhost:1234/v1" />
                    <button type="button" class="btn" id="refreshConnection">Test</button>
                  </div>
                  <p class="lm-op-message" id="connectionMessage" aria-live="polite">Waiting for local API.</p>
                </div>

                <section id="lmStep3" class="lm-sync-cells" aria-labelledby="syncConfigHeading">
                  <h3 id="syncConfigHeading" class="sr-only">Config sync</h3>
                  <div class="lm-op-cell sync-target" id="lmConfigPi">
                    <div class="sync-target-main">
                      <span class="sync-target-name">Pi config</span>
                      <span class="lm-config-indicator" id="lmConfigPiStatus">Checking…</span>
                      <span class="sync-target-path" id="lmConfigPiPath">~/.pi/agent/models.json</span>
                    </div>
                    <img class="sync-target-logo sync-target-logo-pi" src="/assets/pi-logo.svg" alt="" aria-hidden="true" />
                    <button type="button" class="btn-sm-outline" id="syncPiBtn">Sync Pi</button>
                  </div>
                  <div class="lm-op-cell sync-target" id="lmConfigOpenCode">
                    <div class="sync-target-main">
                      <span class="sync-target-name">OpenCode config</span>
                      <span class="lm-config-indicator" id="lmConfigOpenCodeStatus">Checking…</span>
                      <span class="sync-target-path" id="lmConfigOpenCodePath">~/.config/opencode/opencode.json</span>
                    </div>
                    <img class="sync-target-logo sync-target-logo-opencode" src="/assets/opencode-logo.svg" alt="" aria-hidden="true" />
                    <button type="button" class="btn-sm-outline" id="syncOpenCodeBtn">Sync OpenCode</button>
                  </div>
                </section>
              </div>
              <p class="lm-sync-message" id="syncMessage" aria-live="polite">
                Start LM Studio, test the URL, then sync discovered models to your tool configs.
              </p>

              <section id="lmStep2" class="lm-model-section" aria-labelledby="modelInventoryHeading">
                <div class="lm-model-section-head">
                  <div>
                    <h3 id="modelInventoryHeading">Model inventory</h3>
                    <p>Live LM Studio models plus saved run history.</p>
                  </div>
                </div>
                <div class="lm-model-table-head" id="lmModelHeader">
                  <span>Model</span>
                  <span>Source</span>
                  <span>Config status</span>
                </div>
                <div class="available-model-list" id="availableModelChoices"></div>
              </section>

            </section>
          </div>
        </div>
      </article>
    </div>

    <script is:inline src="viewer.js"></script>
  </body>
</html>

---
import "../styles/global.css";

const title = "Local LLM Visual Benchmark";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="mx-auto flex min-h-14 w-full max-w-[1600px] items-center gap-4 px-4 md:px-5">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <div class="grid size-8 place-items-center rounded-lg border bg-card text-xs font-semibold shadow-sm">
              LV
            </div>
            <div class="min-w-0">
              <h1 class="truncate-line text-sm font-semibold tracking-[-0.01em]">
                Local LLM Visual Benchmark
              </h1>
              <p class="muted-copy truncate-line text-xs">
                Browse and collect visual benchmark outputs.
              </p>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <span class="badge-outline gap-1.5 text-xs" id="statsPill" title="System stats">
              <span id="statsDot" class="status-dot" data-state="offline"></span>
              <span id="statsCompact">Loading…</span>
            </span>
            <button type="button" class="btn-sm-outline" id="setupToggle">Setup</button>
            <button type="button" class="btn" id="runToggle">Prepare run</button>
          </div>
        </div>
      </header>

      <main class="mx-auto w-full max-w-[1600px] px-4 py-4 md:px-5 md:py-5">
        <div class="grid gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-lg border bg-muted p-0.5">
              <button type="button" class="btn-sm-ghost" data-mode="gallery" aria-pressed="true">Gallery</button>
              <button type="button" class="btn-sm-ghost" data-mode="benchmark">By prompt</button>
              <button type="button" class="btn-sm-ghost" data-mode="model">By model</button>
            </div>
            <div class="dropdown-wrap">
              <select id="modelFilter" class="input text-sm" aria-label="Filter by model">
                <option value="all">All run models</option>
              </select>
            </div>
            <div class="dropdown-wrap">
              <select id="benchmarkFilter" class="input text-sm" aria-label="Filter by prompt">
                <option value="all">All prompts</option>
              </select>
            </div>
            <button type="button" class="btn-sm-outline ml-auto" id="refreshRuns">Refresh</button>
          </div>

          <div class="gallery-summary">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h2 id="viewTitle" class="text-lg font-semibold tracking-[-0.01em]">Run gallery</h2>
                <span class="badge-outline" id="runCount">0</span>
              </div>
              <p class="muted-copy mt-0.5 text-sm" id="viewSubtitle">Browse saved visual outputs.</p>
              <p class="muted-copy text-sm" id="runSummary">Loading saved runs.</p>
            </div>
          </div>

          <div id="runsSurface"></div>
        </div>
      </main>
    </div>

    <!-- Detail Modal -->
    <div class="detail-backdrop" id="detailBackdrop">
      <article class="detail-shell" role="dialog" aria-modal="true" aria-label="Run detail">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 id="detailTitle" class="truncate-line text-lg font-semibold">Run detail</h2>
            <p class="muted-copy truncate-line mt-1 text-sm" id="detailSubtitle"></p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <button type="button" class="btn-sm-danger" id="deleteRun">Delete run</button>
            <button type="button" class="btn-sm-outline" id="closeDetail">Close</button>
          </div>
        </header>
        <div class="detail-body p-5">
          <div class="grid min-w-0 gap-4">
            <div id="detailPreview"></div>
            <div class="detail-actions" id="detailActions">
              <a class="btn-sm-outline" id="htmlLink" href="#" target="_blank" rel="noreferrer">Open HTML</a>
              <a class="btn-sm-outline" id="rawLink" href="#" target="_blank" rel="noreferrer">Raw response</a>
            </div>
          </div>
          <aside class="detail-inspector">
            <div class="run-identity">
              <div class="meta-grid" id="detailMeta"></div>
            </div>
            <section class="inspector-section">
              <div class="section-row">
                <h3>Prompt</h3>
                <span class="badge-outline" id="promptLength">0 chars</span>
              </div>
              <pre class="code-block prompt-block" id="detailPrompt"></pre>
            </section>
            <section class="inspector-section compact-section">
              <div class="section-row">
                <h3>Filesystem</h3>
              </div>
              <pre class="code-block paths-block" id="detailPaths"></pre>
            </section>
          </aside>
        </div>
      </article>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="detail-backdrop" id="deleteConfirmBackdrop">
      <article class="confirm-shell" role="dialog" aria-modal="true" aria-label="Delete run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Delete run?</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">This removes the run folder from disk.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeDeleteConfirm">Close</button>
        </header>
        <div class="grid gap-4 p-5">
          <div class="rounded-lg border border-[oklch(0.78_0.06_28)] bg-[oklch(0.97_0.018_28)] p-3">
            <p class="text-sm font-medium text-[oklch(0.45_0.12_28)]">This cannot be undone.</p>
            <p class="muted-copy mt-1 text-sm leading-5">The whole run folder will be deleted, including metadata, prompt, HTML, preview, and raw response files.</p>
          </div>
          <div class="grid gap-1">
            <span class="section-label">Run folder</span>
            <code class="code-inline-path" id="deleteRunPath"></code>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button type="button" class="btn-sm-outline" id="cancelDeleteRun">Cancel</button>
            <button type="button" class="btn-sm-danger" id="confirmDeleteRun">Delete folder</button>
          </div>
        </div>
      </article>
    </div>

    <!-- Prepare Run Modal -->
    <div class="detail-backdrop" id="prepBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="Prepare run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Prepare run slot</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Choose a prompt and model to generate a run folder.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closePrep">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="prep-layout" id="prepLayout">
            <section class="prep-form-panel" aria-label="Run slot inputs">
              <div class="grid gap-2">
                <label for="prepBenchmark">Prompt</label>
                <select id="prepBenchmark" class="input"></select>
              </div>
              <div class="grid gap-2">
                <label for="prepModelSelect">Discovered model</label>
                <select id="prepModelSelect" class="input"></select>
              </div>
              <button class="btn w-full" type="button" id="prepareRun">Prepare slot</button>
              <p class="muted-copy text-sm leading-5" id="prepMessage">The app will create the folder, metadata.json, and prompt.md.</p>
            </section>

            <section id="prepResult" class="next-step-panel prep-prompt-panel" aria-label="Generated prompt">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <h3 class="text-sm font-medium">Generated prompt</h3>
                  <p class="muted-copy mt-0.5 text-xs">Copy this into your external tool after preparing the slot.</p>
                </div>
                <button type="button" class="btn-sm-outline" id="copyPrompt" disabled>Copy</button>
              </div>
              <textarea
                id="preparedPrompt"
                class="input font-mono text-[0.82rem] leading-5"
                placeholder="Prepare a run slot to generate the exact prompt and output path."
                readonly
              ></textarea>
              <p class="muted-copy text-sm" id="preparedPaths">No run slot prepared yet.</p>
            </section>
          </div>
        </div>
      </article>
    </div>

    <!-- Setup Modal -->
    <div class="detail-backdrop" id="setupBackdrop">
      <article class="prep-shell lm-studio-shell" role="dialog" aria-modal="true" aria-label="Setup">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Setup</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Configure LM Studio, then prepare runs and save generated artifacts.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeSetup">Close</button>
        </header>
        <div class="prep-body p-5">
          <div class="grid gap-6">
            <section class="grid gap-3" aria-labelledby="workflowHeading">
              <div>
                <h3 id="workflowHeading" class="text-base font-semibold">Benchmark workflow</h3>
                <p class="muted-copy mt-1 text-sm leading-5">This app prepares folders and inspects saved HTML. Your local tool still runs the model.</p>
              </div>
              <ol class="setup-flow-list">
                <li>
                  <span class="setup-flow-index">1</span>
                  <div>
                    <h4>Prepare a run slot</h4>
                    <p>Pick a prompt and model. The app writes the run folder, metadata, and paste-ready prompt.</p>
                  </div>
                </li>
                <li>
                  <span class="setup-flow-index">2</span>
                  <div>
                    <h4>Run in your tool</h4>
                    <p>Paste the prompt into Pi, OpenCode, LM Studio chat, or another local tool. Save the HTML to the requested path.</p>
                  </div>
                </li>
                <li>
                  <span class="setup-flow-index">3</span>
                  <div>
                    <h4>Refresh the gallery</h4>
                    <p>Refresh when files land. Open a run card to inspect the artifact, prompt, metadata, and filesystem paths.</p>
                  </div>
                </li>
              </ol>
            </section>

            <section class="grid gap-4" aria-labelledby="lmStudioHeading">
              <div>
                <h3 id="lmStudioHeading" class="text-base font-semibold">LM Studio</h3>
                <p class="muted-copy mt-1 text-sm leading-5">Use LM Studio as the local model source for Pi and OpenCode config sync.</p>
              </div>

              <div id="lmStep1" class="grid gap-2">
                <label for="baseUrl" class="section-label">LM Studio URL</label>
                <div class="lm-connection-row">
                  <input id="baseUrl" class="input flex-1" aria-label="LM Studio base URL" value="http://localhost:1234/v1" />
                  <button type="button" class="btn" id="refreshConnection">Test</button>
                </div>
                <p class="muted-copy text-sm leading-5" id="connectionMessage" aria-live="polite">Waiting for local API.</p>
              </div>
            </section>

            <section id="lmStep2" class="grid gap-3" aria-labelledby="modelInventoryHeading">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <h3 id="modelInventoryHeading" class="text-base font-semibold">Model inventory</h3>
                  <p class="muted-copy mt-1 text-sm leading-5">Live LM Studio models plus saved run history, with Pi and OpenCode config status.</p>
                </div>
                <span class="badge-outline" id="availableModelCount">0</span>
              </div>
              <div class="grid grid-cols-[1fr_auto] gap-x-3 gap-y-0 items-center pb-2 border-b border-border text-[0.72rem] font-semibold uppercase tracking-wide text-muted-foreground" id="lmModelHeader">
                <span>Model</span>
                <span class="flex gap-2">
                  <span class="min-w-[5.5rem] text-center" title="Is this model in your Pi config?">Pi</span>
                  <span class="min-w-[5.5rem] text-center" title="Is this model in your OpenCode config?">OpenCode</span>
                </span>
              </div>
              <div class="available-model-list" id="availableModelChoices"></div>
            </section>

            <section id="lmStep3" class="grid gap-3" aria-labelledby="syncConfigHeading">
              <div>
                <h3 id="syncConfigHeading" class="text-base font-semibold">Config sync</h3>
                <p class="muted-copy mt-1 text-sm leading-5">Replace only the LM Studio section in each config with currently discovered models.</p>
              </div>
              <div class="grid gap-1">
                <div class="flex items-center justify-between gap-2 rounded-lg border border-border px-3 py-2 text-sm" id="lmConfigPi">
                  <span class="font-medium overflow-wrap-anywhere" id="lmConfigPiPath">~/.pi/agent/models.json</span>
                  <span class="lm-config-indicator shrink-0 inline-flex items-center gap-1 text-[0.75rem] font-semibold" id="lmConfigPiStatus">Checking…</span>
                </div>
                <div class="flex items-center justify-between gap-2 rounded-lg border border-border px-3 py-2 text-sm" id="lmConfigOpenCode">
                  <span class="font-medium overflow-wrap-anywhere" id="lmConfigOpenCodePath">~/.config/opencode/opencode.json</span>
                  <span class="lm-config-indicator shrink-0 inline-flex items-center gap-1 text-[0.75rem] font-semibold" id="lmConfigOpenCodeStatus">Checking…</span>
                </div>
              </div>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="btn" id="syncPiBtn">Sync to Pi</button>
                <button type="button" class="btn" id="syncOpenCodeBtn">Sync to OpenCode</button>
              </div>
              <p class="muted-copy text-sm leading-5" id="syncMessage" aria-live="polite">
                Start LM Studio, test the URL, then sync discovered models to your tool configs.
              </p>
            </section>
          </div>
        </div>
      </article>
    </div>

    <script is:inline src="viewer.js"></script>
  </body>
</html>

---
import PostHog from "./PostHog.astro";
import "../styles/global.css";

const title = "Local LLM Visual Benchmark";
const basePath = import.meta.env.BASE_URL;
const subtitle = "Browse visual benchmark outputs by prompt, model, or table.";
const isStaticBuild = process.env.ASTRO_OUTPUT === "static";
const iconStyle = (name: string) => `--icon: url('${basePath}assets/icons/${name}.svg')`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <PostHog />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch {}
    </script>
  </head>
  <body data-workspace="visual" data-base-path={basePath} data-static-build={isStaticBuild ? "true" : undefined}>
    <div class="app-shell">
      <header class="app-header">
        <div class="app-header-inner mx-auto flex min-h-14 w-full max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
          <div class="header-title flex min-w-0 flex-1 items-center gap-3">
            <div class="min-w-0">
              <h1 class="truncate-line text-sm font-semibold tracking-[-0.01em]">
                Local LLM Visual Benchmark
              </h1>
              <p class="muted-copy truncate-line text-xs">{subtitle}</p>
            </div>
          </div>

          <a class="sidequest-attribution" href="https://eeshans.com/" target="_blank" rel="noopener">
            a side quest by <span>eeshans.com</span>
          </a>

          <div class="header-actions flex shrink-0 items-center gap-2">
            <a class="btn-sm-outline source-pill" href="https://github.com/eeshansrivastava89/local-llm-visual-benchmark" target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub">
              <span class="ui-icon" aria-hidden="true" style={iconStyle("github")}></span>
              <span>Source</span>
            </a>
            <span class="badge-outline machine-pill gap-1.5 text-xs" id="statsPill" data-tooltip="Machine profile loading." tabindex="0" role="status" aria-label="Machine profile">
              <span class="ui-icon" aria-hidden="true" style={iconStyle("sparkles")}></span>
              <span id="statsDot" class="status-dot" data-state="checking"></span>
              <span id="statsCompact">Machine</span>
            </span>
            <button type="button" class="btn-sm-outline icon-only-btn" id="themeToggle" aria-label="Use dark theme" title="Use dark theme">
              <span id="themeIcon" aria-hidden="true">☾</span>
              <span class="sr-only" id="themeLabel">Dark</span>
            </button>
            <button type="button" class="btn-sm-outline operational-control" id="setupToggle"><span class="ui-icon" aria-hidden="true" style={iconStyle("settings")}></span>Setup</button>
            <button type="button" class="btn operational-control" id="runToggle"><span class="ui-icon" aria-hidden="true" style={iconStyle("plus")}></span>Prepare run</button>
          </div>
        </div>
      </header>

      <main class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6 lg:px-8 md:py-5">
        <div class="grid gap-4">
          <!-- Onboarding -->
          <div id="onboardingPanel" class="onboarding-panel" hidden>
            <div class="onboarding-header">
              <h2 class="text-sm font-semibold">Welcome — 5 steps to your first benchmark</h2>
              <button type="button" class="btn-sm-ghost" id="dismissOnboarding">Dismiss</button>
            </div>
            <ol class="onboarding-steps">
              <li data-onboarding-step="1"><span class="step-num">1</span>Start oMLX or LM Studio</li>
              <li data-onboarding-step="2"><span class="step-num">2</span>Load a model</li>
              <li data-onboarding-step="3"><span class="step-num">3</span>Pick a prompt</li>
              <li data-onboarding-step="4"><span class="step-num">4</span>Generate with your tool</li>
              <li data-onboarding-step="5"><span class="step-num">5</span>Capture preview</li>
            </ol>
          </div>

          <!-- Toolbar -->
          <div class="toolbar">
            <div class="view-tabs">
              <button type="button" class="view-tab" data-mode="benchmark" aria-pressed="true"><span class="ui-icon" aria-hidden="true" style={iconStyle("panels-top-left")}></span>By prompt</button>
              <button type="button" class="view-tab" data-mode="model" aria-pressed="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("boxes")}></span>By model</button>
              <button type="button" class="view-tab" data-mode="table" aria-pressed="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("table-2")}></span>Table</button>
            </div>
            <div class="toolbar-filters">
              <div class="dropdown-wrap">
                <select id="modelFilter" class="input text-sm" aria-label="Filter by model">
                  <option value="all">All models</option>
                </select>
              </div>
              <div class="dropdown-wrap">
                <select id="benchmarkFilter" class="input text-sm" aria-label="Filter by prompt">
                  <option value="all">All prompts</option>
                </select>
              </div>
              <div class="dropdown-wrap">
                <select id="harnessFilter" class="input text-sm" aria-label="Filter by harness">
                  <option value="all">All harnesses</option>
                </select>
              </div>
              <input
                id="runsSearch"
                class="input text-sm"
                type="search"
                aria-label="Search runs"
                placeholder="Search runs, models, prompts, harnesses"
              />
              <button type="button" class="btn-sm-outline operational-control" id="refreshRuns" data-icon="refresh-cw"><span class="ui-icon" aria-hidden="true" style={iconStyle("refresh-cw")}></span>Refresh</button>
            </div>
          </div>

          <!-- Summary -->
          <div class="gallery-summary">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
              <h2 id="viewTitle" class="text-lg font-semibold tracking-[-0.01em]">Prompt comparison</h2>
                <span class="badge-outline" id="runCount">0</span>
              </div>
              <p class="muted-copy mt-0.5 text-sm" id="viewSubtitle">{subtitle}</p>
              <p class="muted-copy text-sm" id="runSummary">Loading saved runs.</p>
            </div>
            <button type="button" class="btn-sm-outline gallery-reset" id="clearWorkbenchState" data-icon="x" hidden><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span><span id="clearWorkbenchStateLabel">Clear filters</span></button>
          </div>

          <!-- Surface -->
          <div id="runsSurface"></div>
        </div>
      </main>

      <div id="helpTooltip" class="help-tooltip-layer" role="tooltip" hidden></div>

      <footer class="footer" role="contentinfo">
        <span>&copy; 2025&ndash;2026 Eeshan Srivastava</span>
        <span>Personal project &middot; MIT License &middot; Non-commercial</span>
        <span class="footer-links">
          <a href="https://github.com/eeshansrivastava89/local-llm-visual-benchmark" target="_blank" rel="noopener noreferrer">Source</a>
          <a href="https://www.linkedin.com/in/eeshans/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </span>
      </footer>
    </div>

    <!-- Visual Detail Modal -->
    <div class="detail-backdrop" id="detailBackdrop">
      <article class="detail-shell" role="dialog" aria-modal="true" aria-label="Run detail">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 id="detailTitle" class="truncate-line text-lg font-semibold">Run detail</h2>
            <p class="muted-copy truncate-line mt-1 text-sm" id="detailSubtitle"></p>
          </div>
          <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
            <button type="button" class="btn-sm-outline operational-control" id="openHtml" data-icon="file-code" data-operational-available="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("file-code")}></span>Open HTML</button>
            <button type="button" class="btn-sm-outline operational-control" id="copyDetailPath" data-icon="copy" data-operational-available="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("copy")}></span>Copy path</button>
            <button type="button" class="btn-sm-outline operational-control" id="openRunFolder" data-icon="folder-open" data-operational-available="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("folder-open")}></span>Open in Finder</button>
            <button type="button" class="btn-sm-outline operational-control" id="recaptureRun" data-icon="camera" data-operational-available="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("camera")}></span>Recapture media</button>
            <button type="button" class="btn-sm-danger operational-control" id="deleteRun" data-icon="trash-2" data-operational-available="false"><span class="ui-icon" aria-hidden="true" style={iconStyle("trash-2")}></span>Delete run</button>
            <button type="button" class="btn-sm-outline" id="closeDetail"><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span>Close</button>
          </div>
        </header>
        <div class="detail-body p-5">
          <div class="grid min-w-0">
            <div id="detailPreview"></div>
          </div>
          <aside class="detail-inspector">
            <div class="run-identity">
              <div class="meta-grid" id="detailMeta"></div>
            </div>
            <section class="inspector-section">
              <div class="section-row">
                <h3 id="detailTextTitle">Prompt</h3>
                <div class="section-actions">
                  <span class="badge-outline" id="promptLength">0 chars</span>
                  <button type="button" class="btn-sm-outline" id="copyDetailPrompt" data-icon="copy"><span class="ui-icon" aria-hidden="true" style={iconStyle("copy")}></span>Copy prompt</button>
                </div>
              </div>
              <pre class="code-block prompt-block" id="detailPrompt"></pre>
            </section>

          </aside>
        </div>
      </article>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="detail-backdrop" id="deleteConfirmBackdrop">
      <article class="confirm-shell" role="dialog" aria-modal="true" aria-label="Delete run">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Delete run?</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">This removes the run folder from disk.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeDeleteConfirm"><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span>Close</button>
        </header>
        <div class="grid gap-4 p-5">
          <div class="rounded-lg border border-[oklch(0.78_0.06_28)] bg-[oklch(0.97_0.018_28)] p-3">
            <p class="text-sm font-medium text-[oklch(0.45_0.12_28)]">This cannot be undone.</p>
            <p class="muted-copy mt-1 text-sm leading-5">The whole run folder will be deleted, including metadata, prompt, HTML, preview, and raw response files.</p>
          </div>
          <div class="grid gap-1">
            <span class="section-label">Run folder</span>
            <code class="code-inline-path" id="deleteRunPath"></code>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button type="button" class="btn-sm-outline" id="cancelDeleteRun"><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span>Cancel</button>
            <button type="button" class="btn-sm-danger" id="confirmDeleteRun"><span class="ui-icon" aria-hidden="true" style={iconStyle("trash-2")}></span>Delete folder</button>
          </div>
        </div>
      </article>
    </div>

    <!-- Prepare Run Modal -->
    <div class="detail-backdrop" id="prepBackdrop">
      <article class="prep-shell" role="dialog" aria-modal="true" aria-label="Prepare run">
        <header class="detail-header">
          <div class="prep-header-copy min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Prepare run slot</h2>
            <p class="muted-copy truncate-line mt-1 text-sm" id="prepSubtitle">Choose a prompt and model to generate a run folder.</p>
          </div>
          <div class="prep-header-actions">
            <div class="source-status-rack operational-control" aria-label="Local model source status">
              <span
                class="source-status-pill"
                id="omlxStatusPill"
                role="status"
                data-source="omlx"
                data-status="checking"
                data-tooltip="Checking oMLX model server."
              >
                <span id="omlxStatusDot" class="status-dot" data-state="checking"></span>
                <span id="omlxStatusText">oMLX checking</span>
              </span>
              <span
                class="source-status-pill"
                id="lmStudioStatusPill"
                role="status"
                data-source="lmstudio"
                data-status="checking"
                data-tooltip="Checking LM Studio model server."
              >
                <span id="lmStudioStatusDot" class="status-dot" data-state="checking"></span>
                <span id="lmStudioStatusText">LM Studio checking</span>
              </span>
            </div>
            <button class="btn" type="button" id="prepareRun" data-icon="play"><span class="ui-icon" aria-hidden="true" style={iconStyle("play")}></span>Prepare slot</button>
            <button type="button" class="btn-sm-outline" id="closePrep"><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span>Close</button>
          </div>
        </header>
        <div class="prep-body p-5">
          <div class="prep-layout" id="prepLayout">
            <section class="prep-form-panel" aria-label="Run slot inputs">
              <div class="grid gap-2" id="prepBackendHelperGroup">
                <div class="field-label-row">
                  <label for="prepRunner">Coding harness</label>
                  <button type="button" class="help-pill" data-tooltip="The tool you plan to paste the generated prompt into. The harness is recorded because tool calling and file writes affect run quality.">?</button>
                </div>
                <select id="prepRunner" class="input">
                  <option value="manual">Manual chat</option>
                  <option value="opencode">OpenCode</option>
                  <option value="pi">Pi</option>
                  <option value="hermes">Hermes</option>
                </select>
              </div>
              <div class="grid gap-2" id="prepModelSourceGroup">
                <div class="field-label-row">
                  <label for="prepModelSource">Model source</label>
                  <button type="button" class="help-pill" data-tooltip="Choose whether the model label comes from oMLX or LM Studio. oMLX is the primary Apple Silicon daily-driver lane.">?</button>
                </div>
                <select id="prepModelSource" class="input">
                  <option value="omlx">oMLX</option>
                  <option value="lmstudio">LM Studio</option>
                  <option value="custom">Custom model</option>
                </select>
              </div>
              <div class="grid gap-2" id="prepVisualPromptGroup">
                <div class="field-label-row">
                  <label for="prepBenchmark">Prompt</label>
                  <button type="button" class="help-pill" data-tooltip="Visual benchmark prompt. Run your external tool from the prepared run folder; the generated prompt only asks it to write index.html in the current directory.">?</button>
                </div>
                <select id="prepBenchmark" class="input"></select>
              </div>
              <div class="grid gap-2" id="prepModelSelectGroup">
                <div class="field-label-row">
                  <label for="prepModelSelect" id="prepModelSelectLabel">Discovered model</label>
                  <button type="button" class="help-pill" data-tooltip="Model discovered from the selected local source. The app records this label and source in prepared run metadata.">?</button>
                </div>
                <select id="prepModelSelect" class="input"></select>
                <p id="prepModelWarning" class="prep-source-warning" hidden></p>
              </div>
              <div class="grid gap-2" id="prepCustomBackendGroup" hidden>
                <div class="field-label-row">
                  <label for="prepCustomBackend">Custom backend</label>
                  <button type="button" class="help-pill" data-tooltip="Free-form source label for manually run models, for example cloud, ChatGPT, Claude, OpenRouter, or browser.">?</button>
                </div>
                <input id="prepCustomBackend" class="input" value="cloud" placeholder="cloud" />
              </div>
              <div class="grid gap-2" id="prepCustomModelGroup" hidden>
                <div class="field-label-row">
                  <label for="prepCustomModel">Custom model</label>
                  <button type="button" class="help-pill" data-tooltip="Free-form model label to record in metadata and use for the run folder, for example ChatGPT or GPT-5.1.">?</button>
                </div>
                <input id="prepCustomModel" class="input" placeholder="ChatGPT" />
              </div>
            </section>

            <section id="prepResult" class="next-step-panel prep-prompt-panel" aria-label="Generated prompt">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <h3 class="text-sm font-medium" id="prepResultTitle">Generated prompt</h3>
                  <p class="muted-copy mt-0.5 text-xs" id="prepResultHint">Copy this into your external tool after preparing the slot.</p>
                </div>
              </div>
              <div class="prep-artifact prep-output-artifact" id="prepOutputGroup">
                <div class="prep-artifact-head">
                  <div>
                    <div class="field-label-row">
                      <label for="preparedPrompt" id="prepOutputLabel">Visual prompt</label>
                      <button type="button" class="help-pill" data-tooltip="Generated prompt for this visual run. Copy it after preparing the slot, then run your tool from the prepared run folder.">?</button>
                    </div>
                  </div>
                  <div class="section-actions">
                    <button type="button" class="btn-sm-outline" id="copyPreparedPath" data-icon="copy" disabled><span class="ui-icon" aria-hidden="true" style={iconStyle("copy")}></span>Copy path</button>
                    <button type="button" class="btn-sm-outline" id="copyPrompt" data-icon="copy" disabled><span class="ui-icon" aria-hidden="true" style={iconStyle("copy")}></span>Copy prompt</button>
                  </div>
                </div>
                <textarea id="preparedPrompt" class="input font-mono text-[0.82rem] leading-5" placeholder="Prepare a run slot to generate the prompt for index.html."></textarea>
              </div>
              <p class="muted-copy text-sm" id="preparedPaths">No run slot prepared yet.</p>
            </section>
          </div>
        </div>
      </article>
    </div>

    <!-- Setup Modal -->
    <div class="detail-backdrop" id="setupBackdrop">
      <article class="prep-shell lm-studio-shell" role="dialog" aria-modal="true" aria-label="Setup">
        <header class="detail-header">
          <div class="min-w-0">
            <h2 class="truncate-line text-lg font-semibold">Setup</h2>
            <p class="muted-copy truncate-line mt-1 text-sm">Refresh oMLX or LM Studio models, then prepare runs and save generated artifacts.</p>
          </div>
          <button type="button" class="btn-sm-outline" id="closeSetup"><span class="ui-icon" aria-hidden="true" style={iconStyle("x")}></span>Close</button>
        </header>
        <div class="prep-body setup-body">
          <div class="setup-console-layout">
            <section class="lm-source-panel" aria-labelledby="lmStudioHeading">
              <div class="lm-source-heading">
                <div class="min-w-0">
                  <span class="section-label">Local model source</span>
                  <h3 id="lmStudioHeading">Model sources</h3>
                  <p>Discover oMLX and LM Studio models. LM Studio models can still be mirrored into Pi and OpenCode when needed.</p>
                </div>
                <span class="badge-outline lm-count-badge"><span id="availableModelCount">0</span> models</span>
              </div>

              <div class="lm-operations-grid">
                <div id="lmStepOmlx" class="lm-op-cell lm-connect-cell">
                  <div class="lm-op-head">
                    <span class="lm-op-title">oMLX</span>
                    <span class="section-label">oMLX URL</span>
                  </div>
                  <div class="lm-op-control lm-connect-control">
                    <input id="omlxBaseUrl" class="input flex-1" aria-label="oMLX base URL" value="http://127.0.0.1:8000/v1" />
                    <button type="button" class="btn" id="refreshOmlx" data-icon="refresh-cw"><span class="ui-icon" aria-hidden="true" style={iconStyle("refresh-cw")}></span>Refresh</button>
                  </div>
                  <p class="lm-op-message" id="omlxConnectionMessage" aria-live="polite">Waiting for local API.</p>
                </div>

                <div id="lmStep1" class="lm-op-cell lm-connect-cell">
                  <div class="lm-op-head">
                    <span class="lm-op-title">LM Studio</span>
                    <span class="section-label">LM Studio URL</span>
                  </div>
                  <div class="lm-op-control lm-connect-control">
                    <input id="baseUrl" class="input flex-1" aria-label="LM Studio base URL" value="http://localhost:1234/v1" />
                    <button type="button" class="btn" id="refreshConnection" data-icon="refresh-cw"><span class="ui-icon" aria-hidden="true" style={iconStyle("refresh-cw")}></span>Refresh</button>
                  </div>
                  <p class="lm-op-message" id="connectionMessage" aria-live="polite">Waiting for local API.</p>
                </div>

                <section id="lmStep3" class="lm-sync-cells" aria-labelledby="syncConfigHeading">
                  <h3 id="syncConfigHeading" class="sr-only">Config sync</h3>
                  <div class="lm-op-cell sync-target" id="lmConfigPi">
                    <div class="sync-target-main">
                      <span class="sync-target-name">Pi config</span>
                      <span class="lm-config-indicator" id="lmConfigPiStatus">Checking…</span>
                      <span class="sync-target-path" id="lmConfigPiPath">~/.pi/agent/models.json</span>
                    </div>
                    <img class="sync-target-logo sync-target-logo-pi" src={`${basePath}assets/pi-logo.svg`} alt="" aria-hidden="true" />
                    <button type="button" class="btn-sm-outline" id="syncPiBtn"><span class="ui-icon" aria-hidden="true" style={iconStyle("refresh-cw")}></span>Sync Pi</button>
                  </div>
                  <div class="lm-op-cell sync-target" id="lmConfigOpenCode">
                    <div class="sync-target-main">
                      <span class="sync-target-name">OpenCode config</span>
                      <span class="lm-config-indicator" id="lmConfigOpenCodeStatus">Checking…</span>
                      <span class="sync-target-path" id="lmConfigOpenCodePath">~/.config/opencode/opencode.json</span>
                    </div>
                    <img class="sync-target-logo sync-target-logo-opencode" src={`${basePath}assets/opencode-logo.svg`} alt="" aria-hidden="true" />
                    <button type="button" class="btn-sm-outline" id="syncOpenCodeBtn"><span class="ui-icon" aria-hidden="true" style={iconStyle("refresh-cw")}></span>Sync OpenCode</button>
                  </div>
                </section>
              </div>
              <p class="lm-sync-message" id="syncMessage" aria-live="polite">Start LM Studio, refresh its model list, then sync discovered LM Studio models to your tool configs.</p>

              <section id="lmStep2" class="lm-model-section" aria-labelledby="modelInventoryHeading">
                <div class="lm-model-section-head">
                  <div>
                    <h3 id="modelInventoryHeading">Model inventory</h3>
                    <p>Live oMLX and LM Studio models plus saved run history.</p>
                  </div>
                </div>
                <div class="lm-model-table-head" id="lmModelHeader">
                  <span>Model</span>
                  <span>Source</span>
                  <span>Config status</span>
                </div>
                <div class="available-model-list" id="availableModelChoices"></div>
              </section>
            </section>
          </div>
        </div>
      </article>
    </div>

    <script is:inline type="module" src={`${basePath}viewer.js`}></script>
  </body>
</html>
